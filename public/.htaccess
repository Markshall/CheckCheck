# Rules for CheckCheck at www.mark-eriksson.com/check/.
#
# The portfolio's root .htaccess (in the mark-eriksson.com repo) applies here
# too: it sets HSTS, nosniff and Referrer-Policy, serves its own 404 page, and
# leaves /check/ out of its Content-Security-Policy and caching rules. Rules
# here only need AllowOverride FileInfo, which the root .htaccess relies on too.

# The page used to be index.php. Send old links and bookmarks to the folder.
RedirectMatch 301 ^(.*/)index\.php$ $1

# No folder listing for the built assets. It gets the portfolio's 404 page.
RedirectMatch 404 /assets/$

# Apache doesn't know the web app manifest's type by default.
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Browsers check for a new page every time (a cheap 304 when nothing has
  # changed), so they never pair an old page with deleted assets. Cloudflare
  # keeps it for up to 4 hours, and the deploy purges it when it changes.
  <Files "index.html">
    Header set Cache-Control "public, max-age=0, must-revalidate, s-maxage=14400"
  </Files>

  # Built files in assets/ have a content hash in their names, so a changed
  # file gets a new URL and these can be cached for good.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # The service worker and manifest keep their URLs, so they're checked like
  # the page. A stale service worker would keep serving an old version.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate, s-maxage=14400"
  </FilesMatch>

  # The logo and icons keep their URLs. A day is short enough for a change to
  # show up soon, and the deploy purges them from Cloudflare when they change.
  <FilesMatch "^(logo\.png|icon[^/]*\.(png|svg)|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
