# Rules for CheckCheck at www.mark-eriksson.com/check/.
#
# The portfolio's root .htaccess (in the mark-eriksson.com repo) applies here
# too: it sets HSTS, nosniff and Referrer-Policy, serves its own 404 page, and
# leaves /check/ out of its Content-Security-Policy and caching rules. Rules
# here only need AllowOverride FileInfo, which the root .htaccess relies on too.

# The app is deployed as a git clone, so hide everything that isn't the app:
# dotfiles and folders (.git, .idea, ...), the docs, the tests, and the folder
# listings for css/ and js/. They get the portfolio's 404 page.
RedirectMatch 404 /\.
RedirectMatch 404 /(README\.md|package\.json)$
RedirectMatch 404 /tests(/|$)
RedirectMatch 404 /(css|js)/$

<IfModule mod_headers.c>
  # Cloudflare caches the page, and nothing purges it when CheckCheck is
  # deployed, so it keeps a copy for 5 minutes at most. Browsers check for a
  # new version every time.
  <Files "index.php">
    Header set Cache-Control "public, max-age=0, must-revalidate, s-maxage=300"
  </Files>

  # Stylesheets, scripts and the logo are cached for a day. When one changes,
  # bump the ?v on its <link> or <script> in index.php so it's fetched at once.
  <FilesMatch "\.(css|js|png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
